    {
      "id": 4,
      "type": "stat",
      "title": "Low alerts",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT count() AS alerts FROM sentinelflow.alerts FINAL WHERE $__timeFilter(first_seen) AND level = 'low'",
          "refId": "A"
        }
