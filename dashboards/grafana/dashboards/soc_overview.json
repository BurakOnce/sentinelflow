    {
      "id": 5,
      "type": "timeseries",
      "title": "Alerts over time by level",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(first_seen) AS time, countIf(level = 'critical') AS critical, countIf(level = 'high') AS high, countIf(level = 'medium') AS medium, countIf(level = 'low') AS low FROM sentinelflow.alerts FINAL WHERE $__timeFilter(first_seen) GROUP BY time ORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 80
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "critical"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "dark-red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "high"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "medium"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "low"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Events per minute by source",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(timestamp) AS time, countIf(source_type = 'nginx') AS nginx, countIf(source_type = 'ssh') AS ssh, countIf(source_type = 'firewall') AS firewall, countIf(source_type = 'app') AS app FROM sentinelflow.events WHERE $__timeFilter(timestamp) GROUP BY time ORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 30
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Most triggered rules",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT rule_title, count() AS alerts FROM sentinelflow.alerts FINAL WHERE $__timeFilter(first_seen) GROUP BY rule_title ORDER BY alerts DESC LIMIT 10",
          "refId": "A"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "values": true,
          "calcs": []
        }
      }
    },
    {
      "id": 8,
      "type": "geomap",
      "title": "Attacker locations",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 8,
        "y": 12,
        "w": 16,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT entity AS ip, dictGet('sentinelflow.geoip_city', 'latitude', toIPv4(entity)) AS latitude, dictGet('sentinelflow.geoip_city', 'longitude', toIPv4(entity)) AS longitude, any(country) AS country, count() AS alerts, max(risk_score) AS risk FROM sentinelflow.alerts FINAL WHERE $__timeFilter(first_seen) AND entity_type = 'ip' AND dictHas('sentinelflow.geoip_city', toIPv4(entity)) GROUP BY ip",
          "refId": "A"
        }
      ],
      "options": {
        "view": {
          "id": "zero",
          "lat": 30,
          "lon": 30,
          "zoom": 1
        },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": true
        },
        "basemap": {
          "type": "default",
          "name": "Basemap"
        },
        "layers": [
          {
            "type": "markers",
            "name": "Attackers",
            "location": {
              "mode": "coords",
              "latitude": "latitude",
              "longitude": "longitude"
            },
            "config": {
              "size": {
                "field": "alerts",
                "min": 4,
                "max": 20,
                "fixed": 6
              },
              "color": {
                "field": "risk",
                "fixed": "red"
              },
              "showLegend": true
            },
            "tooltip": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-YlRd"
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Riskiest source addresses",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT entity AS ip, any(country) AS country, any(as_org) AS network, max(risk_score) AS risk, count() AS alerts, arrayStringConcat(groupUniqArray(rule_name), ', ') AS rules, max(is_known_malicious) AS known_bad FROM sentinelflow.alerts FINAL WHERE $__timeFilter(first_seen) AND entity_type = 'ip' GROUP BY ip ORDER BY risk DESC, alerts DESC LIMIT 10",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "risk"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "continuous-GrYlRd"
                }
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 100
              }
            ]
          }
        ]
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Riskiest users",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT coalesce(if(entity_type = 'user', entity, NULL), user_name) AS user, max(risk_score) AS risk, count() AS alerts, arrayStringConcat(groupUniqArray(rule_name), ', ') AS rules, max(last_seen) AS last_seen FROM sentinelflow.alerts FINAL WHERE $__timeFilter(first_seen) AND user IS NOT NULL GROUP BY user ORDER BY risk DESC, alerts DESC LIMIT 10",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "risk"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "continuous-GrYlRd"
                }
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 100
              }
            ]
          }
        ]
      }
    }
  ]
}
